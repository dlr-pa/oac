# ignore ALL .log files
*.log
*LogFile

# ignore cache directories
.pytest_cache/
.mypy_cache/
__pycache__/
# ignore OpenAirClim cache
/cache/

# ignore Jupyter Notebooks
/ipynb/

# ignore repositories and input data
example/input/
docs/source/demos/input/emi_inv_*.nc
docs/source/demos/input/*.txt
repository/
tests/core/repository/*.*
tests/core/repository/cache
# exceptions
!tests/core/repository/co2_bg.nc

# ignore local settings
.vscode/
.coverage
.continue/

# ignore autogenerated files
docs/build/
tests/coverage/
coverage.xml
coverage.svg

# distribution files
build/
dist/
*.egg-info/
# ignore output
results/
